# ============================================================
# Library Occupancy Detection System — Environment Template
# Copy this file to '.env' and fill in your local credentials.
# ============================================================

# ----------------------------------------------------------
# DATABASE (PostgreSQL + TimescaleDB)
# ----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=library_occupancy
DB_USER=library_user
DB_PASSWORD=your_db_password

# ----------------------------------------------------------
# REDIS (Live State Cache)
# ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=occupancy
REDIS_STATE_TTL_SEC=300

# ----------------------------------------------------------
# API SERVER & PIPELINE
# ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
USE_ZONE_PIPELINE=true

# ----------------------------------------------------------
# CAMERA STREAMS (RTSP URLs)
# ----------------------------------------------------------
CAM_01_URL=rtsp://your-camera-ip:554/stream1
CAM_02_URL=rtsp://your-camera-ip:554/stream1
CAM_03_URL=rtsp://your-camera-ip:554/stream1
CAM_04_URL=rtsp://your-camera-ip:554/stream1
CAM_05_URL=rtsp://your-camera-ip:554/stream1
CAM_06_URL=rtsp://your-camera-ip:554/stream1
CAM_07_URL=rtsp://your-camera-ip:554/stream1
CAM_08_URL=rtsp://your-camera-ip:554/stream1
CAM_09_URL=rtsp://your-camera-ip:554/stream1
CAM_10_URL=rtsp://your-camera-ip:554/stream1
CAM_11_URL=rtsp://your-camera-ip:554/stream1

# ----------------------------------------------------------
# MODEL CONFIGURATION
# ----------------------------------------------------------
MODEL_WEIGHTS_PATH=models/yolov10x.pt
MODEL_CONFIDENCE_THRESHOLD=0.45
MODEL_DEVICE=cuda
